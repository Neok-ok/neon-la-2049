{
  "name": "neon-la-2049",
  "private": true,
  "version": "0.1.0",
  "description": "Fan-made browser tribute to the Los Angeles of Blade Runner 2049, built with three.js (WebGPU + WebGL2 fallback).",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "map": "node scripts/gen-map.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.64.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.4"
  }
}
