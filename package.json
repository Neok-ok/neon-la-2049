{
  "name": "neon-la-2049",
  "private": true,
  "version": "0.1.0",
  "description": "Fan-made browser tribute to the Los Angeles of Blade Runner 2049, built with three.js (WebGPU + WebGL2 fallback).",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && npm run lighting:check && vite build",
    "lighting:check": "node scripts/check-lighting.mjs && node --experimental-strip-types scripts/lighting-selfcheck.ts",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "memory:check": "node tools/memory/run-logic.mjs && node tools/memory/guard-scan.mjs",
    "textures": "node scripts/encode-ktx2.mjs",
    "map": "node scripts/gen-map.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "turntable": "node scripts/model-turntable.mjs",
    "stray": "node tools/model-harness/scripts/test-stray.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "ktx2-encoder": "^0.6.0",
    "playwright": "^1.64.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.4"
  }
}
